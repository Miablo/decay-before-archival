# Copy to .env and fill in your own GCP project (BigQuery sandbox / free tier works fine).
GOOGLE_CLOUD_PROJECT=your-project-id-here

# Optional: a GitHub token (no scopes needed for public repo search/read) raises the
# rate limits for github_api.ipynb from 10 searches/min + 60 core req/h to 30/min + 5,000/h.
# Leave blank if you don't have one — the notebook runs unauthenticated at the lower limits.
GITHUB_TOKEN=
